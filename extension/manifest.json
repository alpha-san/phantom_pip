{
  "manifest_version": 3,
  "name": "PhantomPiP",
  "version": "1.0",
  "description": "Send the current page or a link to the PhantomPiP see-through overlay app.",
  "permissions": ["contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open in PhantomPiP",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
